{
  "tiers": [
    {
      "name": "power",
      "description": "Persistent Ubuntu 24.04 XFCE desktop, root inside the unprivileged container, no GPU",
      "defaults": {"cpu": 2, "memory_mib": 6144, "disk_gib": 40},
      "min": {"cpu": 1, "memory_mib": 2048, "disk_gib": 20},
      "max": {"cpu": 4, "memory_mib": 8192, "disk_gib": 80},
      "gpu": false, "root_access": true, "ephemeral": false, "persistent_storage": "local",
      "image": {"alias": "mea-desktop-24.04"},
      "lxd_profiles": ["default"], "process_limit": 5000
    },
    {
      "name": "eleet",
      "description": "Persistent Ubuntu 24.04 XFCE desktop with shared NVIDIA GPU, root inside the unprivileged container",
      "defaults": {"cpu": 4, "memory_mib": 12288, "disk_gib": 60},
      "min": {"cpu": 2, "memory_mib": 4096, "disk_gib": 20},
      "max": {"cpu": 8, "memory_mib": 16384, "disk_gib": 120},
      "gpu": true, "root_access": true, "ephemeral": false, "persistent_storage": "local",
      "image": {"alias": "mea-desktop-24.04"},
      "lxd_profiles": ["default"], "process_limit": 10000,
      "nvidia_driver_capabilities": "compute,utility,graphics,video"
    }
  ]
}
