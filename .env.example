# Type3 configuration. Copy to .env for local development: cp .env.example .env
# This file must never contain secret values. Certificates and keys are
# referenced by path (or file://, env://, s3:// URI) and API keys by hash.

# --- API server ---
# Bind to loopback by default. Type3 is an internal admin API: never expose it
# publicly. Set TLS files when binding to a non-loopback address.
TYPE3_LISTEN_ADDR=127.0.0.1:8080
TYPE3_TLS_CERT_FILE=
TYPE3_TLS_KEY_FILE=

# API keys as name:role:sha256(key), comma separated. Generate with:
#   go run ./cmd/type3 gen-key admin admin
# Roles: viewer (read), operator (container lifecycle), admin (hosts, images, forced actions).
TYPE3_API_KEYS=
# Or a JSON file: [{"name":"admin","role":"admin","sha256":"..."}]
TYPE3_API_KEYS_FILE=

# --- State and profiles ---
TYPE3_STATE_FILE=./data/state.json
# Optional tier overrides, see config/profiles.example.json
TYPE3_PROFILES_FILE=

# --- Logging ---
TYPE3_LOG_LEVEL=info
TYPE3_LOG_FORMAT=text
# Audit log (JSON lines). Empty = stderr.
TYPE3_AUDIT_LOG_FILE=./data/audit.log

# --- LXD client identity (mTLS) ---
# The certificate must be trusted on each LXD host:
#   lxc config trust add config/type3-client.crt --name type3
TYPE3_LXD_CLIENT_CERT=./config/type3-client.crt
TYPE3_LXD_CLIENT_KEY=./config/type3-client.key
# Optional CA for LXD hosts running in PKI mode (otherwise pin each host's server cert at registration)
TYPE3_LXD_CA_CERT=
# Only for s3:// references; credentials come from the default AWS chain.
AWS_REGION=

# --- Safety ---
# Reject LXD endpoints that resolve to public IPs.
TYPE3_ALLOW_PUBLIC_LXD_ENDPOINTS=false
TYPE3_ALLOW_UNIX_SOCKET=true
TYPE3_IDMAP_ISOLATED=true
TYPE3_NIC_PORT_ISOLATION=true

# --- Defaults for new hosts and containers ---
TYPE3_DEFAULT_NETWORK=lxdbr0
TYPE3_DEFAULT_STORAGE_POOL=default
TYPE3_DEFAULT_IMAGE_SERVER=ubuntu
# Extra simplestreams servers: name=https://url,name2=https://url2
TYPE3_IMAGE_SERVERS=
TYPE3_CPU_OVERCOMMIT=4
TYPE3_MEMORY_OVERCOMMIT=1
# Containers allowed to share one NVIDIA GPU (unverified on hardware; tuned in M6)
TYPE3_MAX_CONTAINERS_PER_GPU=4

# --- Timeouts ---
TYPE3_LXD_REQUEST_TIMEOUT=30s
TYPE3_OPERATION_TIMEOUT=15m
TYPE3_GRACEFUL_STOP_TIMEOUT=60s
TYPE3_SHUTDOWN_TIMEOUT=30s
TYPE3_HEALTH_INTERVAL=30s
TYPE3_HOST_FAILURE_THRESHOLD=3
TYPE3_RECONCILE_INTERVAL=5m
TYPE3_OPERATION_RETENTION=24h
