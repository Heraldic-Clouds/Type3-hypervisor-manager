{
  "tiers": [
    {
      "name": "newbie",
      "description": "Disposable Ubuntu container, no GPU, no administrator access",
      "defaults": {"cpu": 1, "memory_mib": 1024, "disk_gib": 10},
      "min": {"cpu": 1, "memory_mib": 512, "disk_gib": 5},
      "max": {"cpu": 2, "memory_mib": 2048, "disk_gib": 20},
      "gpu": false, "root_access": false, "ephemeral": true, "persistent_storage": "none",
      "image": {"server": "ubuntu", "alias": "24.04"},
      "lxd_profiles": ["default"], "process_limit": 2000
    },
    {
      "name": "power",
      "description": "Ubuntu container with root inside the unprivileged container, no GPU",
      "defaults": {"cpu": 2, "memory_mib": 6144, "disk_gib": 40},
      "min": {"cpu": 1, "memory_mib": 1024, "disk_gib": 10},
      "max": {"cpu": 4, "memory_mib": 8192, "disk_gib": 100},
      "gpu": false, "root_access": true, "ephemeral": false, "persistent_storage": "local",
      "image": {"server": "ubuntu", "alias": "24.04"},
      "lxd_profiles": ["default"], "process_limit": 5000
    },
    {
      "name": "eleet",
      "description": "Ubuntu container with shared NVIDIA GPU access and root inside the unprivileged container",
      "defaults": {"cpu": 4, "memory_mib": 12288, "disk_gib": 80},
      "min": {"cpu": 2, "memory_mib": 4096, "disk_gib": 20},
      "max": {"cpu": 8, "memory_mib": 16384, "disk_gib": 200},
      "gpu": true, "root_access": true, "ephemeral": false, "persistent_storage": "local",
      "image": {"server": "ubuntu", "alias": "24.04"},
      "lxd_profiles": ["default"], "process_limit": 10000,
      "nvidia_driver_capabilities": "compute,utility,graphics,video,display"
    }
  ]
}
