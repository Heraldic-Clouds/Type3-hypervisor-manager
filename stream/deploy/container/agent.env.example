# /etc/mea-stream/agent.env (written by Type3 when it creates the desktop)
MEA_DESKTOP_ID=<MEA desktop id>
# Public half only; the private key never leaves the MEA API.
MEA_STREAM_PUBLIC_KEY=<base64 Ed25519 public key>
MEA_ENCODER=auto            # native NvFBC+NVENC, falls back to ffmpeg nvenc
MEA_CAPTURE_BIN=/usr/local/bin/mea-capture
MEA_AGENT_LISTEN=:47100     # reachable only from the host bridge (see README)
MEA_AUDIO=true
