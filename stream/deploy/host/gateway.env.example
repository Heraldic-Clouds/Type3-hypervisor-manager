# /etc/mea-stream/gateway.env on the GPU host (mode 0600, owner mea-stream)
MEA_HOST_ID=<Type3 host id; must equal MEA_STREAM_HOST_ID in the MEA API>
MEA_STREAM_PUBLIC_KEY=<base64 Ed25519 public key>
MEA_PUBLIC_IPS=<the host's Elastic/public IPv4>
MEA_MEDIA_PORT=47998        # one UDP (and ICE-TCP) port for all sessions
MEA_ICE_TCP=true
MEA_LISTEN=:443
MEA_TLS_DOMAIN=stream.miseenaby.me
MEA_TLS_EMAIL=<ops email for Let's Encrypt>
MEA_ALLOWED_ORIGINS=https://miseenaby.me
MEA_ADMIN_LISTEN=127.0.0.1:47990
MEA_ADMIN_TOKEN_FILE=/etc/mea-stream/admin.token
MEA_REGISTRY_FILE=/var/lib/type3/stream-agents.json
# Stay at 1 until the L4 benchmark (docs/BENCHMARK.md) proves more.
MEA_MAX_SESSIONS=1
MEA_MAX_ENCODER_PCT=85
MEA_MAX_GPU_PCT=95
MEA_MIN_FREE_MEM_MIB=1024
